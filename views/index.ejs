<%- include("header") -%>

    <div class="box" id="heading">
        <h1><%= title %></h1>
    </div>

    <div class="box">
        <% for(var i=0;i<myTodos.length;i++){ %>
            <form action="/delete" method="POST">
                <div class="item">
                    <input type="checkbox" name="checkboxItem"  value="<%= myTodos[i]._id %>" onchange="this.form.submit()">
                    <p><%= myTodos[i].todo %></p>
                </div>
            </form>
        <% } %>
        <form class="item"  action="/" method="post">
            <input type="text" placeholder="New Todo" name="newTodo" autocomplete="off">
            <button type="submit" value=<%= title %> name="addTodo">+</button>
        </form>
    </div>
    



<%- include("footer") -%>
